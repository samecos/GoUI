# Leave empty to use the page host (including its port) and /ws.
# Vite dev/preview proxies /ws to ws://127.0.0.1:8090 on the frontend machine.
# Production hosting must proxy /ws, or set an explicit reachable backend URL.
# HTTP pages use ws://; HTTPS pages use wss://.
# Optional local override: ws://127.0.0.1:8090/ws
# VITE_* values are public and embedded at build time. Never put secrets here.
VITE_ENGINE_WS_URL=
